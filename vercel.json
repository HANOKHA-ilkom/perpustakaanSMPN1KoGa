{
  "version": 2,
  "functions": {
    "api/**/*.php": {
      "runtime": "vercel-php@0.7.3"
    },
    "index.php": {
      "runtime": "vercel-php@0.7.3"
    }
  },
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/cover_buku/(.*)",
      "dest": "/cover_buku/$1"
    },
    {
      "src": "/diagram_perpustakaan.html",
      "dest": "/diagram_perpustakaan.html"
    },
    {
      "src": "/(.*)",
      "dest": "/index.php"
    }
  ]
}
