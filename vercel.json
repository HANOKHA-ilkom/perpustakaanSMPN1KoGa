{
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/cover_buku/(.*)",
      "dest": "/cover_buku/$1"
    },
    {
      "src": "/diagram_perpustakaan.html",
      "dest": "/diagram_perpustakaan.html"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ]
}
